### Paste a JWT obtained through the configured Keycloak login flow.
@helpdeskUrl = http://localhost:8081
@userServiceUrl = http://localhost:8082
@jwt = replace-with-a-valid-jwt
@internalUserToken = replace-with-USER_SERVICE_API_TOKEN-from-local-env

### List tickets
GET {{helpdeskUrl}}/api/tickets
Authorization: Bearer {{jwt}}

### Create a ticket for the authenticated Keycloak user
POST {{helpdeskUrl}}/api/tickets
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "title": "Monitor is not working",
  "description": "Black screen after startup",
  "priority": "HIGH",
  "categoryId": 1
}

### Edit a ticket (AGENT or ADMIN)
PUT {{helpdeskUrl}}/api/tickets/1
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "title": "Monitor issue - updated",
  "description": "Checked the cable; issue persists",
  "priority": "HIGH",
  "categoryId": 1,
  "assignedToId": 2
}

### List users through the user-service (ADMIN JWT)
GET {{userServiceUrl}}/api/users
Authorization: Bearer {{jwt}}

### Read internal user references (service token)
GET {{userServiceUrl}}/internal/users
X-Internal-Token: {{internalUserToken}}
